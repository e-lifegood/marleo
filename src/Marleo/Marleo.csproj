<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>marleo</AssemblyName>
    <RootNamespace>Marleo</RootNamespace>
    <ApplicationIcon>..\..\assets\marleo.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.2.0</Version>
    <Product>Marleo</Product>
    <Description>Fast, clean Markdown viewer for Windows</Description>
    <Copyright>MIT License - Marleo contributors</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Precompiled code: noticeably faster cold start. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <!-- No ICU load at startup; Marleo has no culture-sensitive logic. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The WebView2 package also references its WPF control; harmless in a WinForms app. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- The web UI (HTML/CSS/JS + vendored libraries) is copied next to marleo.exe. -->
  <ItemGroup>
    <None Include="$(RepoRoot)web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)assets\marleo.ico" Link="marleo.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- `mdv` keeps working in terminals (the app was called mdv up to v0.1.0). -->
    <None Update="mdv.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fetch the front-end libraries automatically the first time you build from a fresh clone. -->
  <Target Name="VendorWebLibraries" BeforeTargets="BeforeBuild" Condition="!Exists('$(RepoRoot)web\vendor\markdown-it.min.js')">
    <Message Importance="high" Text="web/vendor is missing: running npm ci + npm run vendor" />
    <Exec WorkingDirectory="$(RepoRoot)" Command="npm ci &amp;&amp; npm run vendor" />
    <ItemGroup>
      <!-- Items created inside a target don't get LinkBase applied, so set Link explicitly. -->
      <_VendorFile Include="$(RepoRoot)web\vendor\**\*" />
      <None Include="@(_VendorFile)" Link="web\vendor\%(_VendorFile.RecursiveDir)%(_VendorFile.Filename)%(_VendorFile.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
